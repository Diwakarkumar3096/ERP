# ==============================================================================
# SCHOOL ERP MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and provide your values before launching in production.
# IMPORTANT: DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL.

# Application Server Configuration
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# Authentication & Session Security
# Provide a cryptographically secure random string (at least 32 characters) for HMAC token signing
SESSION_SECRET=replace_with_a_secure_random_32_character_string_for_production

# AI / Assistant Integrations (Optional)
# Used for daily operational briefings and smart task telemetry suggestions
GEMINI_API_KEY=

# Database Configuration (Optional External PostgreSQL)
# The ERP defaults to embedded high-performance PostgreSQL (ElectricSQL PGlite).
# If connecting to an external dedicated PostgreSQL instance, supply the connection URI:
# DATABASE_URL=postgresql://username:password@localhost:5432/school_erp_db

# Email / SMTP Notification Service (Optional)
# Configure when outbound parent alerts, fee receipts, or password reset emails are enabled
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vidya Vahini Public School <notifications@vvps.edu>"
SMTP_SECURE=false

# SMS / WhatsApp Gateway Integration (Optional)
# Configure for instant attendance absentee circulars and fee payment receipts
SMS_GATEWAY_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=SCHERP
WHATSAPP_API_TOKEN=

# Online Payment Gateway (Optional)
# Used for Parent Portal online fee collection (Razorpay, Stripe, or Cashfree)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
